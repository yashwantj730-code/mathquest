PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/mathquest
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
ALLOW_NULL_ORIGIN=true
# Optional: enables AI step-by-step explanations for typed/photo doubts
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin account. When both are set, the server creates/updates this admin with this password on every start.
# Pick your own strong password; never commit it.
ADMIN_EMAIL=admin@mathquest.dev
ADMIN_PASSWORD=
ADMIN_NAME=MathQuest Admin
# Seed the curriculum + demo users on start when the database is empty (never wipes data)
AUTO_SEED=true
